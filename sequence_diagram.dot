digraph G { graph [rankdir=TB, bgcolor="white", pad="0.25", label="EVENT REGISTRATION SYSTEM — SEQUENCE DIAGRAM", labelloc=t, fontsize=20, nodesep=.45, ranksep=.55]; node [shape=box, style=rounded, fontname="Arial", fontsize=10, color="#44546a", fillcolor="#f5f7fb"]; edge [fontname="Arial", fontsize=9, color="#44546a"]; User [label="User"]; ES [label="EventSystem"]; E [label="Event"]; R [label="Registration"]; FM [label="FileManager"]; {rank=same;User;ES;E;R;FM;} User -> ES [label="1. select register + IDs"]; ES -> ES [label="2. validate IDs and duplicate"]; ES -> E [label="3. check seats / addRegistration()"]; E -> ES [label="4. success or full error"]; ES -> R [label="5. create registration"]; ES -> FM [label="6. save all data files"]; FM -> ES [label="7. save status"]; ES -> User [label="8. confirmation or error"]; }