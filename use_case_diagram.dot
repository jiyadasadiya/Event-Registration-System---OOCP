digraph G { graph [rankdir=LR, bgcolor="white", pad="0.25", label="EVENT REGISTRATION SYSTEM — USE CASE DIAGRAM", labelloc=t, fontsize=20]; node [fontname="Arial", fontsize=10, color="#44546a"]; edge [color="#44546a"]; Participant [shape=plaintext,label="Participant"]; Organizer [shape=plaintext,label="Organizer"]; Admin [shape=plaintext,label="System Administrator"]; subgraph cluster_system { label="Event Registration System"; style="rounded"; color="#44546a"; node [shape=ellipse, style=filled, fillcolor="#f5f7fb"]; UC1 [label="View events"]; UC2 [label="Register for event"]; UC3 [label="Cancel registration"]; UC4 [label="Manage events"]; UC5 [label="Manage participants"]; UC6 [label="Manage organizers"]; UC7 [label="View registrations"]; UC8 [label="Save/load records"]; } Participant -> UC1; Participant -> UC2; Participant -> UC3; Organizer -> UC4; Organizer -> UC7; Admin -> UC4; Admin -> UC5; Admin -> UC6; UC2 -> UC8 [style=dashed,label="includes"]; UC3 -> UC8 [style=dashed,label="includes"]; }