digraph G { graph [rankdir=TB, bgcolor="white", pad="0.25", label="EVENT REGISTRATION SYSTEM — ACTIVITY DIAGRAM", labelloc=t, fontsize=20]; node [fontname="Arial", fontsize=10, color="#44546a", style=filled, fillcolor="#f5f7fb"]; edge [fontname="Arial", fontsize=9, color="#44546a"]; Start [shape=circle,label="",width=.2,fillcolor="#44546a"]; Menu [shape=box,label="Select Register Participant"]; IDs [shape=box,label="Enter participant ID and event ID"]; Valid [shape=diamond,label="Both IDs exist?"]; Dup [shape=diamond,label="Already registered?"]; Seats [shape=diamond,label="Seats available?"]; Create [shape=box,label="Create registration record"]; Count [shape=box,label="Increment registered count"]; Save [shape=box,label="Save all data files"]; Confirm [shape=box,label="Show confirmation"]; Error1 [shape=box,label="Show invalid ID error"]; Error2 [shape=box,label="Show duplicate error"]; Error3 [shape=box,label="Show event full error"]; End [shape=doublecircle,label="",width=.2]; Start -> Menu -> IDs -> Valid; Valid -> Error1 [label="No"]; Error1 -> End; Valid -> Dup [label="Yes"]; Dup -> Error2 [label="Yes"]; Error2 -> End; Dup -> Seats [label="No"]; Seats -> Error3 [label="No"]; Error3 -> End; Seats -> Create [label="Yes"]; Create -> Count -> Save -> Confirm -> End; }